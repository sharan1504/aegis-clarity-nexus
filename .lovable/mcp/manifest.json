{
  "version": 1,
  "sdk_version": "0.26.3",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zvvtvhocznuemcshkdla.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "aegis-operations-hub",
      "version": "0.2.0",
      "title": "Aegis Operations Hub"
    },
    "tools": [
      {
        "name": "get_operations_overview",
        "title": "Get operations overview",
        "description": "Compute an operations snapshot from this tenant's real audit, change, integration, and synchronized-provider telemetry.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_change_records",
        "title": "List change records",
        "description": "List real tenant-scoped Change Control Center records from the same change_records table used by the application UI.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "stage": {
              "description": "Lifecycle stage.",
              "type": "string"
            },
            "risk": {
              "description": "Risk tier.",
              "type": "string"
            },
            "executionMode": {
              "description": "Execution mode.",
              "type": "string"
            },
            "ownerTeam": {
              "description": "Owning team substring.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_change_record",
        "title": "Get change record",
        "description": "Get a real tenant-scoped change record from the same change_records table used by the application UI.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Change ID."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "propose_change_record",
        "title": "Propose a change record",
        "description": "Draft a tenant-scoped change record for human review. This tool can only create a Proposed record with pending approval; it cannot approve, execute, or select an execution mode.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Proposed change title."
            },
            "businessImpact": {
              "type": "string",
              "minLength": 1,
              "description": "Evidence-backed business impact."
            },
            "aiReasoning": {
              "type": "string",
              "minLength": 1,
              "description": "AI reasoning/rationale supporting the proposal."
            },
            "proposedRiskFactors": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Risk factors proposed by the calling agent; these remain unscored until the normal approval/risk pipeline evaluates them."
            },
            "targetProvider": {
              "type": "string",
              "minLength": 1,
              "description": "Provider the proposed change concerns."
            },
            "targetAgent": {
              "type": "string",
              "minLength": 1,
              "description": "Aegis agent or workflow responsible for the proposal."
            }
          },
          "required": [
            "title",
            "businessImpact",
            "aiReasoning",
            "proposedRiskFactors",
            "targetProvider",
            "targetAgent"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_agents",
        "title": "List AI agents",
        "description": "List agent definitions and only the real tenant-scoped bindings currently deployed in this workspace.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "includeFindings": {
              "description": "Include provider-backed finding records when available.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_integrations",
        "title": "List integrations",
        "description": "List the current tenant's real provider integrations, connection status, and sync freshness.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by connected, available, or action_required.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_incidents_and_alerts",
        "title": "List incidents and security alerts",
        "description": "List only real incident and security-alert signals present in the tenant's synchronized provider data. No fallback or demo data is used.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "severity": {
              "description": "Filter by provider-reported severity when present.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_reports_and_recommendations",
        "title": "List reports and AI recommendations",
        "description": "Return only report evidence and proposed changes backed by this tenant's real synchronized data and change records.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "reportId": {
              "description": "Provider dataset key, e.g. github or jira.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
